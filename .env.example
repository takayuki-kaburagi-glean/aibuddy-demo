# ── AI Buddy demo environment (copy this file to .env and fill in the values) ──
#   cp .env.example .env
# What you need: Glean tenant URL / OAuth static client (ID & Secret) / MCP server name.
# Note: the backend is fixed to port 3000 to match the redirect_uri.

# ── Glean connection ─────────────────────────────────────────────────
# No trailing slash. e.g. https://<tenant>-be.glean.com
GLEAN_INSTANCE_URL=https://<tenant>-be.glean.com
GLEAN_AGENT_CARD_URL=https://<tenant>-be.glean.com/.well-known/agent-card.json

# ── OAuth (static client issued in the Glean admin console) ───────────
# Register the value below verbatim as an allowed redirect on the static client.
GLEAN_OAUTH_CLIENT_ID=<your-oauth-client-id>
GLEAN_OAUTH_CLIENT_SECRET=<your-oauth-client-secret>
GLEAN_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# This full set of scopes is required (memory/tools = MCP, inference = LLM_PROXY, real agents = AGENTS)
GLEAN_OAUTH_SCOPES=openid offline_access SEARCH CHAT AGENTS DOCUMENTS ENTITIES TOOLS MCP LLM_PROXY
GLEAN_OAUTH_AUTHORIZE_URL=https://<tenant>-be.glean.com/oauth/authorize
GLEAN_OAUTH_TOKEN_URL=https://<tenant>-be.glean.com/oauth/token

# ── MCP Gateway (source of personal memory / 3rd-party tools) ─────────
# Append the MCP server name you created in the admin console. Use /mcp/default for the default server.
GLEAN_MCP_URL=https://<tenant>-be.glean.com/mcp/<your-mcp-server-name>

# ── Server settings ──────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5273
SESSION_SECRET=change-me

# ── Orchestrator model via the LLM Gateway (AI Buddy's brain: routing/summarization) ──
GLEAN_MODEL=claude-sonnet-4-6
GLEAN_MODELS=claude-sonnet-4-6,claude-opus-4-8

# ── Demo email recipient ─────────────────────────────────────────────
# Configured at runtime in the app's Settings UI (⚙ menu), not via env.
# All email actions are redirected to that address; leave it empty to disable
# the override. Stored in backend/data/registry.json (gitignored).

# ── Optional (works if unset) ────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
